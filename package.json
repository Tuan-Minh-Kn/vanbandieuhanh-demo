{
  "name": "vanbandieuhanh-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev --env=\"\"",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:check": "npm run build && wrangler deploy --dry-run --env=\"\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.0.0"
  }
}
